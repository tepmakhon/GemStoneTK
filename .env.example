# Copy to .env for local development. Do not commit real secrets.
DATABASE_URL=postgresql://takeo:takeo_local_only@localhost:5432/takeo_gemstones?schema=public
API_PORT=4000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Base currency is USD. Set an owner-approved rate before showing KHR conversion.
BASE_CURRENCY=USD
DISPLAY_CURRENCY=KHR
USD_KHR_RATE=

# Placeholder only; configure a strong, randomly generated value outside source control.
SESSION_SECRET=
