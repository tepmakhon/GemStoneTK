generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PricingMethod {
  FIXED
  NEGOTIABLE
  CONTACT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StockStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
  CANCELLED
}

enum InventoryMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SALE
  RETURN
  ADJUSTMENT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum FulfillmentMethod {
  SHOP_PICKUP
  LOCAL_DELIVERY
}

enum PaymentMethod {
  CASH
  ABA_TRANSFER
  ACLEDA_TRANSFER
}

enum PaymentStatus {
  UNPAID
  SUBMITTED
  VERIFIED
  REJECTED
  REFUNDED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  CLOSED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

enum AdminRole {
  OWNER
  MANAGER
  CATALOG_EDITOR
  INVENTORY_CLERK
  PAYMENT_REVIEWER
  CUSTOMER_SUPPORT
  REPORT_VIEWER
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  READY
  COMMITTED
  FAILED
}

model ProductType {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Category {
  id          String         @id @default(cuid())
  parentId    String?
  slug        String         @unique
  nameEn      String
  nameKm      String?
  description String?
  sortOrder   Int            @default(0)
  archivedAt  DateTime?
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]     @relation("CategoryTree")
  products    ProductCategory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([parentId, sortOrder])
  @@index([archivedAt])
}

model Product {
  id                  String               @id @default(cuid())
  sku                 String               @unique
  productTypeId       String
  type                ProductType          @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  pricingMethod       PricingMethod
  status              ProductStatus        @default(DRAFT)
  onHand              Int                  @default(0)
  weightValue         Decimal?             @db.Decimal(12, 4)
  weightUnit          String?
  color               String?
  dimensions          String?
  origin              String?
  naturalStatus       String?
  treatmentStatus     String?
  certification       String?
  unitPrice           Decimal?             @db.Decimal(18, 4)
  currency            String               @default("USD")
  primaryMediaId      String?              @unique
  primaryMedia        ProductMedia?        @relation("PrimaryMedia", fields: [primaryMediaId], references: [id], onDelete: SetNull)
  categories          ProductCategory[]
  translations        ProductTranslation[]
  media               ProductMedia[]       @relation("ProductMedia")
  reservations        InventoryReservation[]
  movements           InventoryMovement[]
  orderItems          OrderItem[]
  quotationItems      QuotationItem[]
  inquiryProducts     InquiryProduct[]
  cartItems           CartItem[]
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, onHand])
  @@index([productTypeId, status])
  @@index([createdAt])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  locale      String
  name        String
  description String?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, locale])
  @@index([locale, name])
}

model ProductMedia {
  id          String   @id @default(cuid())
  productId   String
  storageKey  String
  mediaType   String
  mimeType    String
  altEn       String?
  altKm       String?
  sortOrder   Int      @default(0)
  isVideo     Boolean  @default(false)
  product     Product  @relation("ProductMedia", fields: [productId], references: [id], onDelete: Restrict)
  primaryFor  Product? @relation("PrimaryMedia")
  createdAt   DateTime @default(now())

  @@index([productId, sortOrder])
}

model Customer {
  id           String            @id @default(cuid())
  email        String?           @unique
  phone        String?
  fullName     String
  passwordHash String?
  addresses    CustomerAddress[]
  orders       Order[]
  inquiries    Inquiry[]
  quotations   Quotation[]
  carts        Cart[]
  sessions     UserSession[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([phone])
  @@index([fullName])
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  label       String?
  fullName    String
  phone       String
  line1       String
  line2       String?
  city        String
  province    String
  postalCode  String?
  countryCode String   @default("KH")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model AdminUser {
  id                String              @id @default(cuid())
  email             String              @unique
  fullName          String
  passwordHash      String
  role              AdminRole
  disabledAt        DateTime?
  reviewedPayments  Payment[]           @relation("PaymentReviewer")
  inventoryMovements InventoryMovement[]
  auditLogs         AuditLog[]
  importJobs        ImportJob[]
  sessions          UserSession[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([role, disabledAt])
}

model Cart {
  id        String     @id @default(cuid())
  tokenHash String?    @unique
  customerId String?
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     CartItem[]
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([customerId, expiresAt])
  @@index([expiresAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id                 String              @id @default(cuid())
  orderNumber        String              @unique
  customerId         String?
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName       String
  customerEmail      String?
  customerPhone      String
  status             OrderStatus         @default(PENDING_PAYMENT)
  fulfillmentMethod FulfillmentMethod
  deliveryAddress    Json?
  currency           String              @default("USD")
  exchangeRate       Decimal?            @db.Decimal(18, 6)
  subtotal           Decimal             @db.Decimal(18, 4)
  deliveryAmount     Decimal             @default(0) @db.Decimal(18, 4)
  total              Decimal             @db.Decimal(18, 4)
  customerNote       String?
  items              OrderItem[]
  payments           Payment[]
  reservations       InventoryReservation[]
  statusHistory      OrderStatusHistory[]
  shipment           Shipment?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  productId          String?
  skuSnapshot        String
  nameSnapshot       String
  descriptionSnapshot String?
  quantity           Int
  unitPrice          Decimal  @db.Decimal(18, 4)
  lineTotal          Decimal  @db.Decimal(18, 4)
  currency           String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  method            PaymentMethod
  status            PaymentStatus @default(UNPAID)
  amount            Decimal       @db.Decimal(18, 4)
  currency          String
  bankReference     String?
  proofStorageKey   String?
  rejectionReason   String?
  reviewedById      String?
  reviewer          AdminUser?    @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([orderId])
}

model InventoryReservation {
  id        String      @id @default(cuid())
  productId String
  orderId   String
  quantity  Int
  status    StockStatus @default(ACTIVE)
  expiresAt DateTime
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([productId, status, expiresAt])
  @@index([orderId, status])
  @@index([expiresAt, status])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  type          InventoryMovementType
  onHandDelta   Int                   @default(0)
  reservedDelta Int                   @default(0)
  reason        String
  reference     String?
  adminUserId   String?
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  adminUser     AdminUser?            @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([type, createdAt])
}

model OrderStatusHistory {
  id        String     @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  reason    String?
  actorId   String?
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt DateTime   @default(now())

  @@index([orderId, createdAt])
}

model Shipment {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  carrier         String?
  trackingNumber  String?
  status          String
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Inquiry {
  id          String           @id @default(cuid())
  inquiryNumber String          @unique
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name        String
  email       String?
  phone       String?
  country     String?
  message     String
  channel     String?
  status      InquiryStatus    @default(NEW)
  products    InquiryProduct[]
  quotations  Quotation[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model InquiryProduct {
  inquiryId String
  productId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([inquiryId, productId])
  @@index([productId])
}

model Quotation {
  id         String           @id @default(cuid())
  quoteNumber String           @unique
  customerId String?
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  inquiryId  String?
  inquiry    Inquiry?         @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  status     QuotationStatus  @default(DRAFT)
  currency   String           @default("USD")
  subtotal   Decimal          @db.Decimal(18, 4)
  total      Decimal          @db.Decimal(18, 4)
  terms      String?
  expiresAt  DateTime?
  items      QuotationItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, expiresAt])
  @@index([customerId, createdAt])
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  productId    String?
  skuSnapshot  String
  nameSnapshot String
  quantity     Int
  unitPrice    Decimal   @db.Decimal(18, 4)
  lineTotal    Decimal   @db.Decimal(18, 4)
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
}

model ImportJob {
  id             String       @id @default(cuid())
  adminUserId    String
  sourceFileName String
  status         ImportStatus @default(UPLOADED)
  totalRows      Int          @default(0)
  validRows      Int          @default(0)
  invalidRows    Int          @default(0)
  resultSummary  Json?
  adminUser      AdminUser    @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  committedAt    DateTime?

  @@index([status, createdAt])
  @@index([adminUserId, createdAt])
}

model UserSession {
  id         String     @id @default(cuid())
  tokenHash  String     @unique
  customerId String?
  adminUserId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminUser  AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())

  @@index([customerId, expiresAt])
  @@index([adminUserId, expiresAt])
  @@index([expiresAt, revokedAt])
}
